# ==========================================
# 1. PRIVACY & OPERATING SYSTEM HARDENING
# ==========================================
# Blocks hidden OS tracking/cache files that leak local usernames & image paths
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==========================================
# 2. CODE EDITORS & IDE SHIELDS
# ==========================================
# Blocks background configurations from VS Code, Cursor, IntelliJ, etc.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# ==========================================
# 3. SECURITY & CREDENTIAL PROTECTION
# ==========================================
# Strict block on environment variables & API tokens
.env
.env.*
!.env.example

# Logs and error reports (prevents memory/state leak)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime and process data
pids
*.pid
*.seed
*.pid.lock

# ==========================================
# 4. DEPENDENCIES & BUILD CACHES (FUTURE-PROOFING)
# ==========================================
# Node & Framework dependency folders
node_modules/
jspm_packages/
web_modules/
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build and Test Coverages
lib-cov
coverage
*.lcov
.nyc_output
.grunt
build/Release
.cache
.parcel-cache
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm
.node_repl_history
*.tgz
.yarn-integrity

# Static site generators / Framework temporary outputs
.next
out
.nuxt
dist
.output
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test
.vuepress/dist
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/
.lock-wscript